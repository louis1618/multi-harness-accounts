{
  "name": "home-finder",
  "private": true,
  "version": "1.3.1",
  "files": [
    "paseo-plugin.json",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --strict --noEmit false --outDir .check-build --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck server/files.ts && node checks/check.mjs",
    "check:bundle": "node checks/native-bundle-check.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3",
    "@types/node": "^22.0.0",
    "@getpaseo/client": "0.11.1",
    "@getpaseo/protocol": "0.11.1"
  },
  "type": "module"
}
