+  let busy = true, deliveries = 0;
+  const input = { agentId: "agent", messageId: "scheduled", request: { sendGuard: { lastUserMessageAt: null } },
+    send: async () => { if (busy) throw new Error("SCHEDULE_GUARD_BUSY"); deliveries++; } };
+  await expect(requests.send(input)).rejects.toThrow("SCHEDULE_GUARD_BUSY");
+  busy = false;
